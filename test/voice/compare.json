  "lines": [
    {"at": 0.25, "text": "سرّ الألوان المتناسقة؟ ثلاثة أرقام بس."},
    {"at": 3.35, "text": "ستّون بالمية: لون أساسي هادئ للخلفيات."},
    {"at": 6.15, "text": "ثلاثون: لون ثانوي يعطي عمق وتباين."},
    {"at": 8.95, "text": "وعشرة: لمسة مميزة تشدّ العين."},
    {"at": 11.75, "text": "ستّون، ثلاثون، عشرة... والنتيجة توازن."},
    {"at": 15.1, "text": "جرّبها بشغلك الجاي، وتابع كريتيفيا!"}
  ]
}
